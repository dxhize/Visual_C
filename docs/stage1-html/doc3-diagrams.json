  "d3-journal": {
    "title": "Journal record lifecycle",
    "alt": "The reader buffers one bounded line, decodes UTF-8 JSON object with kind/data, pushes typed records with configuration first and a record cap, preserves a torn final line as a flag, and never reconstructs a full trace.",
    "vertical": true,
    "nodes": [
