{
  "d3-pipeline": {
    "title": "Trace Parser pipeline",
    "alt": "Bytes pass ingestion and schema gating, then one TraceStore owns a canonical Arc trace and position indexes. Raw and semantic input views borrow it; explicit deep validation produces a report; TP-6 qualifies evidence; TP-7 composes bounded consumer pages.",
    "caption": "Loading does not run deep validation. The parser never reconstructs a journal into a full trace.",
    "vertical": true,
    "nodes": [
      {
        "label": "Serialized trace / reader",
        "kind": "source",
        "lines": [
          "JSON bytes or existing model"
        ]
      },
      {
        "label": "TP-1 gates + schema",
        "kind": "engine",
        "lines": [
          "Size, UTF-8, schema 2"
        ]
      },
      {
        "label": "TraceStore canonical Arc",
        "kind": "evidence",
        "lines": [
          "Trace + indexes, no record clone"
        ]
      },
      {
        "label": "TP-2 indexes + TP-3 views",
        "kind": "engine",
        "lines": [
          "Positions, borrowed records"
        ]
      },
      {
        "label": "Explicit deep validation",
        "kind": "risk",
        "lines": [
          "Report: corruption/partial/unavailable"
        ]
      },
      {
        "label": "TP-6 validated evidence",
        "kind": "parser",
        "lines": [
          "Relationship confidence"
        ]
      },
      {
        "label": "TP-7 bounded pages",
        "kind": "evidence",
        "lines": [
          "<=128 items, no truncation"
        ]
      }
    ]
  },
  "d3-ingest-json": {
    "title": "JSON ingestion sequence",
    "alt": "open or from_reader checks byte size, read_trace_bytes rejects empty/non-UTF-8, load_trace_document selects JSON and rejects journals, decode_document deserializes and validates schema, then assemble builds indexes and Arc ownership.",
    "vertical": true,
    "nodes": [
